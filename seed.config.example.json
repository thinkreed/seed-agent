{
  "dbPath": "seed.db",
  "workRoot": ".seed/work",
  "slots": 2,
  "intervalMs": 1000,
  "staleSeconds": 1800,
  "speculationSources": ["github"],
  "routerMode": "llm",
  "watchdogMode": "external",
  "model": {
    "baseUrl": "https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1",
    "apiKeyEnv": "BAILIAN_API_KEY",
    "name": "deepseek-v4.1-flash",
    "temperature": 0,
    "maxTokens": 8192
  },
  "sources": {
    "local": { "inbox": "inbox.jsonl" },
    "github": { "reasons": ["review_requested", "mention"] }
  },
  "policy": {
    "acceptMode": "auto",
    "allowedSenders": [["local", "*"], ["github", "*"]],
    "rules": [
      { "source": "local", "actor": "*", "allow": true, "strength": "explicit", "note": "local-explicit" },
      { "source": "github", "actor": "*", "allow": true, "strength": "inferred", "note": "repo-watcher" }
    ]
  }
}