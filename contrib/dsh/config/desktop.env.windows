# seed-agent desktop packaging settings (unsigned local build).
# 由 scripts/apply-dsh-patches.ps1 复制到 dsh/apps/desktop/.env.windows；不含签名凭据。
# 注意：DSH_DESKTOP_UNSIGNED 只能作为进程环境变量传入，不能写在这个文件里。
DSH_DESKTOP_APP_ID=com.seedagent.superagent
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=https://example.invalid
DOWNLOAD_TEST_RELEASE_ID=0123456789abcdef0123456789abcdef
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://example.invalid
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://example.invalid
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["https://example.invalid"]}
DSH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=1