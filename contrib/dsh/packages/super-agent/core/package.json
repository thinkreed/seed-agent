{
    "name":  "@deepseek-ai/dsh-super-agent-core",
    "description":  "Super-agent core: event-sourced domain model, reducer, store and engine (seed-agent port)",
    "version":  "0.2.2-alpha.2",
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "license":  "MIT",
    "scripts":  {
                    "build":  "tsc -b tsconfig.json \u0026\u0026 tsdown"
                },
    "dsh":  {
                "plugin":  {
                               "platform":  "node"
                           }
            },
    "files":  [
                  "lib/**/*.js",
                  "lib/**/*.d.ts",
                  "lib/**/*.json"
              ]
}
