{
    "name":  "@deepseek-ai/dsh-super-agent-host",
    "description":  "Super-agent host plugin: mounts the event-sourced engine as a cordis service",
    "version":  "0.2.2-alpha.2",
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "license":  "MIT",
    "scripts":  {
                    "build":  "tsc -b tsconfig.json \u0026\u0026 tsdown"
                },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "workspace:~",
                             "@deepseek-ai/dsh-sdk-client":  "workspace:*"
                         },
    "dependencies":  {

                     },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "workspace:~",
                            "@deepseek-ai/dsh-super-agent-core":  "workspace:*",
                            "@deepseek-ai/schemastery":  "workspace:*",
                            "@deepseek-ai/dsh-host-webserver":  "workspace:*",
                            "@deepseek-ai/dsh-sdk-client":  "workspace:*"
                        },
    "dsh":  {
                "plugin":  {
                               "platform":  "node"
                           }
            },
    "files":  [
                  "lib/**/*.js",
                  "lib/**/*.d.ts",
                  "lib/**/*.json",
                  "config/*.yml"
              ]
}
