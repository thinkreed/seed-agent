{
  "name": "@deepseek-ai/dsh-super-agent-host",
  "description": "Super-agent host plugin: mounts the event-sourced engine as a cordis service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-sdk-client": "workspace:*",
    "@deepseek-ai/dsh-super-agent-core": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*"
  },
  "dsh": {
    "plugin": {
      "platform": "node"
    }
  }
}
