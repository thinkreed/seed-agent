{
  "name": "@deepseek-ai/dsh-super-agent-bundle",
  "description": "Super-agent bundle: mounts the Router/Worker host plugin and the workbench UI on desktop profiles",
  "version": "0.2.2-alpha.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-super-agent-host": "workspace:*",
    "@deepseek-ai/dsh-client-ui-super-agent": "workspace:*"
  }
}